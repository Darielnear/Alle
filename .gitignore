# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. Next.js, Builds & Caches
# ==========================================
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 3. Variables d'environnement & Secrets
# ==========================================
